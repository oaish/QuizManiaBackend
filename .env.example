# QuizMania Environment Variables Template

# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL Connection URL)
# Replace with your actual MySQL database username, password, host, port, and database name
DATABASE_URL="mysql://root:password@localhost:3060/quizmania"

# JWT Authentication Config
# Change this to a long random secret key in production
JWT_SECRET="quizmania_super_secret_jwt_key_2026_change_me"
JWT_EXPIRATION="24h"

# CORS Allowed Origin
# Change this to your deployed Vercel frontend URL in production
FRONTEND_URL="http://localhost:5173"
